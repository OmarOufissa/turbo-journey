legacy-peer-deps=true

# electron-builder walks node_modules itself to decide what to bundle into
# a packaged app, and doesn't correctly follow pnpm's default symlinked
# node_modules/.pnpm layout - real runtime dependencies silently went
# missing from the packaged Windows app, crashing it on startup with
# "Cannot find module". A flat, hoisted node_modules (closer to what
# npm/yarn classic produce) is what electron-builder actually expects;
# see package.json's "build.extraResources" for the other half of this
# fix (copying node_modules verbatim rather than through electron-builder's
# own - also unreliable - smart-filtering of "files").
node-linker=hoisted
shamefully-hoist=true 